# Copy to .env to override. Every variable is optional.
# CrawlLab never reads secrets. Do not put API keys here.

HOST=0.0.0.0
PORT=43123
FIXTURE_PORT=43124
DATABASE_PATH=data/crawllab.sqlite
ARTIFACT_DIR=data/artifacts
HEADLESS=true
# Leave empty to use Playwright's bundled Chromium. Set to "chrome" for the system browser.
BROWSER_CHANNEL=
BROWSER_CONCURRENCY=2
DEFAULT_TIMEOUT_MS=15000
LOG_LEVEL=info

# Comma-separated hostnames. External hosts also require ALLOW_EXTERNAL=true.
ALLOWLIST_HOSTS=127.0.0.1,localhost
ALLOW_EXTERNAL=false
BOT_USER_AGENT=CrawlLabBot/1.0
